# Supabase → Project Settings → API
SUPABASE_URL=https://qvkkivnlbmktnykllkqc.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do CMS
APP_URL=https://cms.outboxgroup.com.br

# Opcional: assistente de escrita com IA (Claude)
ANTHROPIC_API_KEY=

# Opcional: protege /api/cron/publish-scheduled quando chamado por cron externo
CRON_SECRET=

# Opcional: 1 desliga o agendador interno (use com cron externo)
OUTBOX_DISABLE_SCHEDULER=

# Opcional: modelo do assistente (padrão claude-sonnet-5)
AI_MODEL=

# Só em desenvolvimento: 1 permite webhooks/WordPress em localhost ou rede interna
OUTBOX_ALLOW_PRIVATE_URLS=
