# Supabase → Project Settings → API
SUPABASE_URL=https://qvkkivnlbmktnykllkqc.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do CMS
APP_URL=https://cms.outboxgroup.com.br

# Opcional: domínios aprovados automaticamente no primeiro login (separados por vírgula).
# Só use com "Confirm email" ligado no Supabase. Outras contas esperam aprovação em /equipe.
AUTO_APPROVE_DOMAINS=outboxgroup.com.br

# Opcional: assistente de escrita com IA (Claude)
ANTHROPIC_API_KEY=

# Opcional: protege /api/cron/publish-scheduled quando chamado por cron externo
CRON_SECRET=

# Opcional: 1 desliga o agendador interno (use com cron externo)
OUTBOX_DISABLE_SCHEDULER=

# Opcional: modelo do assistente (padrão claude-sonnet-5)
AI_MODEL=

# Só em desenvolvimento: 1 permite webhooks/WordPress em localhost ou rede interna
OUTBOX_ALLOW_PRIVATE_URLS=

# Opcional: Cloudflare R2 para as imagens (sem estas 5, as imagens ficam no Supabase)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=outbox-cms-midia
R2_PUBLIC_URL=

# Opcional: geração de imagens com IA (Gemini / Nano Banana)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
